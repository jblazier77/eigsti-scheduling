# Copy to .env.ops.local, ignored by Git. OPERATOR COMPUTER ONLY, never Vercel.
# This is separate from app .env.local. Do not paste credentials in chat.
EIGSTI_BACKUP_EXPECTED_REF=
EIGSTI_BACKUP_DB_URL=
# Secret/service-role key used only to read private storage bytes in operator tooling.
EIGSTI_BACKUP_STORAGE_KEY=
# At least 32 characters; retain in a company password manager separate from backup.
EIGSTI_BACKUP_PASSPHRASE=
# Absolute private local output directory OUTSIDE this repository; copy verified archives offsite.
EIGSTI_BACKUP_ROOT=
# Native PostgreSQL binaries, same major version as source server.
EIGSTI_PSQL=psql
EIGSTI_PG_DUMP=pg_dump
EIGSTI_PG_RESTORE=pg_restore
# Optional downloaded PostgreSQL root certificate path for verify-full TLS.
EIGSTI_DB_ROOT_CERT=
